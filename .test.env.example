# Smoke Test Configuration
# Copy this file to .test.env and fill in your API keys.
# Only providers with API_KEY set will be tested.

# Anthropic
PROVIDER_ANTHROPIC_API_KEY=
PROVIDER_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI
PROVIDER_OPENAI_API_KEY=
PROVIDER_OPENAI_MODEL=gpt-4o

# OpenAI Compatible (generic)
PROVIDER_OPENAI_COMPATIBLE_API_KEY=
PROVIDER_OPENAI_COMPATIBLE_MODEL=
PROVIDER_OPENAI_COMPATIBLE_BASE_URL=

# GLM (ZhipuAI)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-4-flash

# GLM CodePlan
PROVIDER_GLM_CODEPLAN_API_KEY=
PROVIDER_GLM_CODEPLAN_MODEL=glm-5.1

# NVIDIA NIM
PROVIDER_NVIDIA_API_KEY=
PROVIDER_NVIDIA_MODEL=minimaxai/minimax-m2.7
